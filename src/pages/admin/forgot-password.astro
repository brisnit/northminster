---
import Admin from '@/layouts/Admin.astro';
export const prerender = false;
---

<Admin title="Forgot password" bare>
  <div class="card">
    <h1>Forgot your password?</h1>
    <p style="margin-block:1rem">For security, password resets are handled by a website administrator. Ask one of them to open <strong>Staff</strong> in the admin and choose <strong>Reset password</strong> next to your name — they’ll send you a secure link that works once and expires in 3 days.</p>
    <p class="hint">Not sure who that is? Call the church office at 858-490-3995.</p>
    <p style="margin-top:1.25rem"><a href="/admin/login" class="btn btn--ghost btn--sm">Back to sign in</a></p>
  </div>
</Admin>
