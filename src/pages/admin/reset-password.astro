---
import Admin from '@/layouts/Admin.astro';
export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
const invalid = Astro.url.searchParams.get('error') === 'INVALID_TOKEN' || !/^[\w-]{10,}$/.test(token);
---

<Admin title="Set your password" bare>
  <div class="card">
    <h1>Set your password</h1>
    {invalid ? (
      <>
        <p style="margin-block:1rem">This link has expired or was already used. Ask a website administrator to send you a new one.</p>
        <a href="/admin/login" class="btn btn--ghost btn--sm">Back to sign in</a>
      </>
    ) : (
      <form id="reset" data-token={token} data-allow-resubmit novalidate>
        <p class="hint" style="margin-block:0.5rem 1rem">Choose a password with at least 10 characters. A short phrase is easy to remember and hard to guess.</p>
        <div class="field">
          <label for="pw">New password</label>
          <input id="pw" type="password" autocomplete="new-password" minlength="10" required />
        </div>
        <div class="field">
          <label for="pw2">Type it again</label>
          <input id="pw2" type="password" autocomplete="new-password" minlength="10" required />
        </div>
        <p class="field-error" id="reset-error" role="alert" hidden></p>
        <button type="submit" class="btn btn--teal" style="margin-top:1.25rem;width:100%">Save password</button>
      </form>
    )}
  </div>
  <script>
    const form = document.getElementById('reset') as HTMLFormElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = document.getElementById('reset-error')!;
      const pw = (document.getElementById('pw') as HTMLInputElement).value;
      const pw2 = (document.getElementById('pw2') as HTMLInputElement).value;
      err.hidden = false;
      if (pw.length < 10) { err.textContent = 'Use at least 10 characters.'; return; }
      if (pw !== pw2) { err.textContent = 'The two passwords don’t match.'; return; }
      err.hidden = true;
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ newPassword: pw, token: form.dataset.token }),
      });
      if (res.ok) { location.href = '/admin/login?notice=' + encodeURIComponent('Password saved. You can sign in now.'); return; }
      err.textContent = 'This link has expired or was already used. Ask an administrator for a new one.';
      err.hidden = false;
    });
  </script>
</Admin>
