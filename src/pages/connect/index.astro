---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import MinistryCard from '@/components/MinistryCard.astro';
import NewHereCTA from '@/components/NewHereCTA.astro';
import Icon from '@/components/Icon.astro';
import { ministries } from '@/content/ministries';
import { weeklyRhythm } from '@/content/events';
import heroImg from '@/assets/photos/camp-lawn.jpg';
import ctaImg from '@/assets/photos/garden-welcome-sign.jpg';

const serve = [
  { title: 'Teach Sunday School', body: 'Men, women and youth lead Bible stories, crafts and activities for kids 3 through 6th grade.' },
  { title: 'Cook on Wednesdays', body: 'Family Night starts with a home-cooked dinner at 5:30. Many hands make it happen.' },
  { title: 'Help with Parents Night Out', body: 'Pizza, crafts, games and a movie for kids — run by volunteers and leaders from our church.' },
  { title: 'Mentor students', body: 'Through Urban Youth Collaborative, our volunteers mentor students at Clairemont High and CPMA.' },
  { title: 'Lead at summer camp', body: 'Artsy Adventure Camp runs on volunteers: outdoor games, art projects and learning about Christ.' },
  { title: 'Read during Advent', body: 'Each December we invite readers to help lead our weekly Advent readings in worship.' },
];
---

<Base title="Connect" description="Find your people at Northminster: kids and families, students, adult Bible studies and family nights, outreach, and our community garden." header="overlay">
  <PageHero
    eyebrow="Connect"
    title="Faith was never meant <em>to be lived alone.</em>"
    lede="Find people to grow, serve, laugh, pray and walk through life with. Here’s where to start."
    image={heroImg}
    imageAlt="A camp volunteer sits on the grass talking with two girls in matching blue shirts"
    position="50% 55%"
  />

  <section class="section" aria-labelledby="ways-title">
    <div class="container">
      <SectionHeader eyebrow="Ways to belong" title="Pick a door. <em>Any door.</em>" id="ways-title" align="split"
        intro="Most people find their way in through one small thing — a Wednesday dinner, a Saturday in the garden, a movie night. You don’t have to do it all." />
      <div class="grid3">
        {ministries.map((m, i) => <MinistryCard ministry={m} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--night" aria-labelledby="week-title">
    <div class="container">
      <SectionHeader eyebrow="A week at Northminster" title="Something <em>almost every day.</em>" id="week-title" align="split">
        <a href="/events" class="btn btn--outline-light">Upcoming events <Icon name="arrow" size={18} class="btn__arrow" /></a>
      </SectionHeader>
      <ul role="list" class="week">
        {weeklyRhythm.map((r, i) => (
          <li data-reveal style={`--reveal-delay:${i % 3}`}>
            <a href={r.href ?? '/events'}>
              <p class="week__day">{r.day}<span>{r.time}</span></p>
              <h3 class="week__title">{r.title}</h3>
              <p class="muted">{r.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="serve" aria-labelledby="serve-title">
    <div class="container">
      <SectionHeader eyebrow="Serve" title="The best way to belong <em>is to pitch in.</em>" id="serve-title" align="split"
        intro="Almost everything here is run by volunteers. If one of these sounds like you, tell us — we’ll connect you with the right person.">
        <a href="/contact" class="btn btn--teal">I’d like to help <Icon name="arrow" size={18} class="btn__arrow" /></a>
      </SectionHeader>
      <ol role="list" class="serve">
        {serve.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i % 3}`}>
            <span class="serve__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h4">{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <NewHereCTA image={ctaImg} imageAlt="A hand-painted “Welcome to our Garden” sign framed by a grapevine wreath on the garden gate" />
</Base>

<style>
  .grid3 { display: grid; gap: 3rem 1.5rem; }
  @media (min-width: 40em) { .grid3 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64em) { .grid3 { grid-template-columns: repeat(3, 1fr); } }

  .week { display: grid; border-top: 1px solid var(--line-night); }
  @media (min-width: 48em) { .week { grid-template-columns: repeat(2, 1fr); column-gap: 3rem; } }
  @media (min-width: 72em) { .week { grid-template-columns: repeat(3, 1fr); } }
  .week li { border-bottom: 1px solid var(--line-night); }
  .week a { display: grid; gap: 0.5rem; padding-block: 1.75rem; text-decoration: none; }
  .week a:hover .week__title { text-decoration: underline; text-decoration-thickness: 1px; }
  .week__day { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  .week__day span { color: var(--on-night-muted); letter-spacing: 0.06em; }
  .week__title { font-family: var(--display); font-size: var(--step-3); font-weight: 380; letter-spacing: -0.02em; line-height: 1.05; }

  .serve { display: grid; gap: 2.5rem 2rem; }
  @media (min-width: 40em) { .serve { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64em) { .serve { grid-template-columns: repeat(3, 1fr); } }
  .serve li { border-top: 1.5px solid var(--ink); padding-top: 1.25rem; }
  .serve__num { display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; color: var(--ember); margin-bottom: 1.25rem; }
  .serve h3 { margin-bottom: 0.5rem; }
</style>
