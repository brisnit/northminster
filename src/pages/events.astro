---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import EventListing from '@/components/EventListing.astro';
import Icon from '@/components/Icon.astro';
import { weeklyRhythm } from '@/content/events';
import { church } from '@/config/site';
import { upcomingEvents } from '@/server/public-events';
import { eventJsonLd } from '@/server/structured-data';

export const prerender = false;

let list: Awaited<ReturnType<typeof upcomingEvents>> = [];
let loadFailed = false;
try {
  list = await upcomingEvents();
} catch (e) {
  loadFailed = true;
  console.error('Events failed to load', e);
}
// Fresh within a minute of a staff change; served from the edge cache meanwhile.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
const jsonLd = list.map((e) => eventJsonLd(e, Astro.url.origin));
---

<Base title="Events" description="What’s happening at Northminster: Parents Night Out, Wednesday Family Nights, Monday Movie Nights, Second Sunday Café and more.">
  {jsonLd.length > 0 && <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
  <PageHero
    eyebrow="Events"
    title="Pull up <em>a chair.</em>"
    lede="Dinners, movie nights, a night off for parents and plenty of coffee. Everything here is open to you — first-timers included."
  >
    <a href={church.links.calendar} class="btn btn--outline" target="_blank" rel="noopener"><Icon name="calendar" size={18} /> Full calendar<span class="visually-hidden"> (Google Calendar, opens in a new tab)</span></a>
  </PageHero>

  <section class="section--tight" aria-labelledby="upcoming-title">
    <div class="container">
      <h2 id="upcoming-title" class="eyebrow upcoming__label">Coming up</h2>
      {list.length === 0 ? (
        <div class="empty">
          <p class="h4">{loadFailed ? 'We couldn’t load events just now.' : 'Nothing special on the calendar right now.'}</p>
          <p class="lede muted">{loadFailed ? 'Please try again in a minute — or call the church office at ' : 'New events are posted regularly. In the meantime, the weekly rhythm below never stops — and Sunday worship is every week at 10 AM. Questions? Call '}<a href={church.phoneHref}>{church.phone}</a>.</p>
        </div>
      ) : (
        <ol role="list" class="elist">
          {list.map((e) => <EventListing event={e} />)}
        </ol>
      )}
    </div>
  </section>

  <section class="section section--night" aria-labelledby="rhythm-title">
    <div class="container">
      <SectionHeader eyebrow="Every week" title="The rhythm of <em>church life.</em>" id="rhythm-title" align="split"
        intro="Can’t make a special event? These happen week in, week out." />
      <ul role="list" class="rhythm">
        {weeklyRhythm.map((r) => (
          <li data-reveal>
            <a href={r.href ?? '#'}>
              <span class="rhythm__day">{r.day}</span>
              <span class="rhythm__title">{r.title}</span>
              <span class="rhythm__time">{r.time}</span>
              <span class="rhythm__desc">{r.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .upcoming__label { color: var(--ember); margin-bottom: 1.5rem; }
  .elist { border-top: 1.5px solid var(--ink); }
  .empty { display: grid; gap: 0.75rem; padding-block: var(--space-l); border-top: 1.5px solid var(--ink); max-width: 44rem; }
  .empty a { color: var(--teal); font-weight: 600; }

  .rhythm { border-top: 1px solid var(--line-night); }
  .rhythm li { border-bottom: 1px solid var(--line-night); }
  .rhythm a { display: grid; gap: 0.35rem 2rem; padding-block: 1.5rem; text-decoration: none; }
  @media (min-width: 56em) { .rhythm a { grid-template-columns: 8rem 1fr 11rem 1.5fr; align-items: baseline; } }
  .rhythm__day { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  .rhythm__title { font-family: var(--display); font-size: var(--step-3); font-weight: 380; letter-spacing: -0.02em; line-height: 1.05; }
  .rhythm a:hover .rhythm__title { text-decoration: underline; text-decoration-thickness: 1px; }
  .rhythm__time { font-weight: 600; }
  .rhythm__desc { color: var(--on-night-muted); }
</style>
