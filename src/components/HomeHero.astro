---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { church } from '@/config/site';
import Icon from './Icon.astro';

/**
 * Full-bleed cinematic hero with art direction: a portrait crop on phones,
 * a wide crop on larger screens. Both are real Northminster photos.
 */
interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
}
const { desktop, mobile, alt } = Astro.props;

async function srcset(img: ImageMetadata, widths: number[], format: 'webp' | 'jpg') {
  const out = await Promise.all(
    widths.filter((w) => w <= img.width).map(async (w) => {
      const r = await getImage({ src: img, width: w, format, quality: 62 });
      return `${r.src} ${w}w`;
    }),
  );
  return out.join(', ');
}

const wide = [960, 1440, 1920, 2400];
const tall = [480, 720, 960, 1200];
const sources = {
  desktop: await srcset(desktop, wide, 'webp'),
  mobile: await srcset(mobile, tall, 'webp'),
};
const fallback = await getImage({ src: desktop, width: 1600, format: 'jpg', quality: 72 });
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <picture>
      <source media="(min-width: 48em)" type="image/webp" srcset={sources.desktop} sizes="100vw" />
      <source type="image/webp" srcset={sources.mobile} sizes="100vw" />
      <img src={fallback.src} alt={alt} width={desktop.width} height={desktop.height} fetchpriority="high" loading="eager" decoding="sync" />
    </picture>
  </div>

  <div class="hero__content container">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow hero__line" style="--i:0">Clairemont, San Diego · Since {church.founded}</p>
      <h1 id="hero-title" class="display hero__title">
        <span class="hero__line" style="--i:1">There’s room</span>
        <span class="hero__line" style="--i:2">at the <em>table.</em></span>
      </h1>
      <p class="hero__lede hero__line" style="--i:3">
        We’re a small, multi-generational church that loves God and our neighbors as ourselves.
        Bring your questions, your kids, your doubts — we’ll have the coffee on.
      </p>
      <div class="btn-row hero__line" style="--i:4">
        <a href="/visit" class="btn btn--light">Plan your visit <svg class="btn__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a href="/messages" class="btn btn--outline-light"><Icon name="play" size={16} /> Watch a message</a>
      </div>
    </div>

    <aside class="hero__card hero__line" style="--i:5" aria-label="Join us Sunday">
      <p class="eyebrow">Join us Sunday</p>
      <p class="hero__card-time">10:00 AM</p>
      <p class="hero__card-place">{church.address.street}<br />{church.address.city}, {church.address.region} {church.address.postalCode}</p>
      <a href={church.directionsUrl} target="_blank" rel="noopener" class="link-arrow">
        Get directions <Icon name="arrow" size={16} /><span class="visually-hidden">(opens Google Maps in a new tab)</span>
      </a>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    min-height: max(100svh, 40rem);
    color: var(--on-night);
    background: var(--night);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%;
  }
  .hero__media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgb(18 14 11 / 0.92) 0%, rgb(18 14 11 / 0.6) 38%, rgb(18 14 11 / 0.15) 70%, rgb(18 14 11 / 0.35) 100%),
      linear-gradient(to right, rgb(18 14 11 / 0.45), transparent 65%);
  }

  .hero__content {
    align-self: end;
    display: grid; gap: 2.5rem;
    padding-top: 10rem;
    padding-bottom: clamp(2rem, 5vw, 4.5rem);
  }
  @media (min-width: 64em) {
    .hero__content { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
  }
  .hero__eyebrow { color: var(--gold); margin-bottom: 1.25rem; }
  .hero__title { display: grid; font-size: clamp(3.6rem, 1.4rem + 9vw, 10.5rem); }
  .hero__title em { color: var(--gold); }
  .hero__lede {
    max-width: 34rem; margin-block: 1.5rem 2rem;
    font-size: var(--step-1); line-height: 1.5; color: rgb(246 241 232 / 0.92);
  }

  .hero__card {
    display: grid; gap: 0.35rem; justify-items: start;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgb(246 241 232 / 0.25);
    border-radius: 6px;
    background: rgb(28 25 22 / 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    min-width: 17rem;
  }
  .hero__card .eyebrow { color: var(--on-night-muted); }
  .hero__card-time { font-family: var(--display); font-size: 2.75rem; line-height: 1; letter-spacing: -0.02em; }
  .hero__card-place { color: rgb(246 241 232 / 0.85); margin-bottom: 0.5rem; }
  @media (max-width: 47.99em) {
    .hero__card { grid-template-columns: auto 1fr; column-gap: 1.25rem; width: 100%; min-width: 0; padding: 1.1rem 1.25rem; }
    .hero__card .eyebrow { grid-column: 1 / -1; }
    .hero__card-time { font-size: 2.1rem; }
    .hero__card-place { font-size: 0.9375rem; margin: 0; }
    .hero__card .link-arrow { grid-column: 1 / -1; }
  }

  /* Motion: staggered entrance + gentle parallax (skipped for reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__line { animation: hero-rise 1.1s var(--ease) both; animation-delay: calc(0.15s + var(--i) * 0.1s); }
    .hero__media img { animation: hero-settle 2.4s var(--ease) both; }
    @supports (animation-timeline: scroll()) {
      .hero__media { animation: hero-parallax linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(30px); } }
  @keyframes hero-settle { from { transform: scale(1.06); } }
  @keyframes hero-parallax { to { transform: translateY(14%); } }
</style>
