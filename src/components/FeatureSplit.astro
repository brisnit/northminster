---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

/**
 * Editorial two-column block: photo on one side, story on the other.
 * Pass `photoNeeded` instead of `image` to show a marked placeholder.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  photoNeeded?: string;
  position?: string;
  ratio?: string;
  reverse?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { id, eyebrow, title, image, imageAlt = '', photoNeeded, position, ratio = '4 / 5', reverse = false, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---

<div class:list={['split', reverse && 'split--reverse']} id={id}>
  <div class="split__media">
    {image ? (
      <Photo src={image} alt={imageAlt} ratio={ratio} position={position} sizes="(min-width: 56em) 45vw, 100vw" />
    ) : (
      <PhotoPlaceholder shot={photoNeeded ?? 'Photo of this ministry in action'} ratio={ratio} />
    )}
  </div>
  <div class="split__text">
    {eyebrow && <p class="eyebrow split__eyebrow" data-reveal>{eyebrow}</p>}
    <H class="h2 split__title" set:html={title} data-reveal />
    <div class="split__body prose" data-reveal><slot /></div>
    {Astro.slots.has('actions') && <div class="btn-row split__actions" data-reveal><slot name="actions" /></div>}
  </div>
</div>

<style>
  .split { display: grid; gap: var(--space-l); align-items: center; }
  @media (min-width: 56em) {
    .split { grid-template-columns: 1fr 1fr; gap: clamp(3rem, 7vw, 7rem); }
    .split--reverse .split__media { order: 2; }
  }
  .split__eyebrow { color: var(--ember); margin-bottom: 1rem; }
  :global(.section--night) .split__eyebrow, :global(.section--teal) .split__eyebrow { color: var(--gold); }
  .split__title { margin-bottom: 1.5rem; }
  .split__body { font-size: var(--step-0); }
  .split__actions { margin-top: 2rem; }
  .split + :global(.split) { margin-top: var(--section); }
</style>
