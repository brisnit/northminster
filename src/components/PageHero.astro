---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

/**
 * Interior page hero.
 * - "image": cinematic full-bleed photo (pair with <Base header="overlay">)
 * - "plain": editorial type-only opener on paper
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  position?: string;
  variant?: 'image' | 'plain';
}
const { eyebrow, title, lede, image, imageAlt = '', position = 'center', variant = image ? 'image' : 'plain' } = Astro.props;
---

<section class:list={['phero', `phero--${variant}`]} aria-labelledby="page-title">
  {variant === 'image' && image && (
    <div class="phero__media">
      <Photo src={image} alt={imageAlt} priority position={position} sizes="100vw" widths={[640, 960, 1440, 1920]} />
    </div>
  )}
  <div class="container phero__inner">
    {eyebrow && <p class="eyebrow phero__eyebrow">{eyebrow}</p>}
    <h1 id="page-title" class="h1 phero__title" set:html={title} />
    {lede && <p class="lede phero__lede">{lede}</p>}
    {Astro.slots.has('default') && <div class="phero__actions"><slot /></div>}
  </div>
</section>

<style>
  .phero { position: relative; isolation: isolate; }
  .phero__eyebrow { margin-bottom: 1.25rem; color: var(--ember); }
  .phero__title { max-width: 15ch; }
  .phero__lede { margin-top: 1.5rem; }
  .phero__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .phero--plain { padding-block: clamp(3.5rem, 8vw, 7rem) clamp(2.5rem, 5vw, 4.5rem); }
  .phero--plain .phero__lede { color: var(--muted); }

  .phero--image {
    display: grid; align-items: end;
    min-height: clamp(34rem, 78svh, 52rem);
    color: var(--on-night); background: var(--night);
    overflow: hidden;
  }
  .phero__media { position: absolute; inset: 0; z-index: -1; }
  .phero__media :global(.media) { height: 100%; border-radius: 0; background: var(--night); }
  .phero__media :global(picture) { height: 100%; }
  .phero__media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgb(18 14 11 / 0.9), rgb(18 14 11 / 0.35) 55%, rgb(18 14 11 / 0.45));
  }
  .phero--image .phero__inner { padding-block: 10rem clamp(2.5rem, 6vw, 5rem); }
  .phero--image .phero__eyebrow { color: var(--gold); }
  .phero--image .phero__lede { color: rgb(246 241 232 / 0.9); }
  .phero--image :global(em) { color: var(--gold); }

  @media (prefers-reduced-motion: no-preference) {
    .phero__inner > * { animation: phero-rise 1s var(--ease) both; }
    .phero__inner > :nth-child(2) { animation-delay: 0.08s; }
    .phero__inner > :nth-child(3) { animation-delay: 0.16s; }
    .phero__inner > :nth-child(4) { animation-delay: 0.24s; }
    @supports (animation-timeline: scroll()) {
      .phero__media { animation: phero-parallax linear both; animation-timeline: scroll(root); animation-range: 0 80vh; }
    }
  }
  @keyframes phero-rise { from { opacity: 0; transform: translateY(24px); } }
  @keyframes phero-parallax { to { transform: translateY(12%); } }
</style>
