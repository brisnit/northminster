---
import type { Faq } from '@/content/visit';
import NeedsInfo from './NeedsInfo.astro';

/** Accessible accordion built on native <details>/<summary>. */
interface Props { items: Faq[] }
const { items } = Astro.props;
---

<div class="faq">
  {items.map((item) => (
    <details class="faq__item" data-reveal>
      <summary class="faq__q">
        <span>{item.q}</span>
        <span class="faq__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq__a">
        <p>{item.a}</p>
        {item.needsConfirmation && <NeedsInfo />}
      </div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__q {
    display: flex; justify-content: space-between; align-items: center; gap: 1.5rem;
    padding-block: 1.4rem;
    font-family: var(--display); font-size: var(--step-2); font-weight: 400; letter-spacing: -0.015em; line-height: 1.15;
    cursor: pointer; list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover span:first-child { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .faq__icon { position: relative; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border: 1.5px solid currentColor; border-radius: 50%; }
  .faq__icon::before, .faq__icon::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 0.8rem; height: 1.5px; background: currentColor;
    translate: -50% -50%; transition: rotate 0.3s var(--ease);
  }
  .faq__icon::after { rotate: 90deg; }
  details[open] .faq__icon::after { rotate: 0deg; }
  .faq__a { padding-bottom: 1.6rem; max-width: 44rem; color: var(--muted); font-size: var(--step-1); line-height: 1.55; }
</style>
