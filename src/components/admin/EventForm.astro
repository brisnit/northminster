---
/**
 * Create / edit event form. Plain HTML form posting to its own page, enhanced
 * with JavaScript for the rich-text editor, photo upload and show/hide logic.
 */
import type { EventInput, FieldErrors } from '@/server/events';
import type { CategoryRow, EventImageRow, EventRow } from '@/db/schema';
import { WEEKDAYS } from '@/server/recurrence';

interface Props {
  values: EventInput;
  errors: FieldErrors;
  categories: CategoryRow[];
  image: Pick<EventImageRow, 'id' | 'url' | 'focalX' | 'focalY' | 'width' | 'height'> | null;
  mode: 'new' | 'edit';
  status?: EventRow['status'];
  creationKey?: string;
  focalX?: number;
  focalY?: number;
}
const { values: v, errors, categories, image, mode, status = 'draft', creationKey, focalX, focalY } = Astro.props;
const errorList = Object.entries(errors) as [string, string][];
const fx = focalX ?? image?.focalX ?? 0.5;
const fy = focalY ?? image?.focalY ?? 0.5;
const isLive = status === 'published' || status === 'cancelled';
const zones = ['America/Los_Angeles', 'America/Denver', 'America/Phoenix', 'America/Chicago', 'America/New_York', 'Pacific/Honolulu', 'America/Anchorage'];
const dayNames: Record<string, string> = { SU: 'Sun', MO: 'Mon', TU: 'Tue', WE: 'Wed', TH: 'Thu', FR: 'Fri', SA: 'Sat' };
const inv = (k: keyof FieldErrors) => (errors[k] ? 'true' : undefined);
const desc = (k: keyof FieldErrors, hint?: string) => [errors[k] && `${k}-error`, hint].filter(Boolean).join(' ') || undefined;
---

<form method="post" class="eform" id="event-form" novalidate>
  {creationKey && <input type="hidden" name="creationKey" value={creationKey} />}

  {errorList.length > 0 && (
    <div class="error-summary" role="alert" tabindex="-1" id="error-summary">
      <h2>Please fix {errorList.length === 1 ? 'this' : `these ${errorList.length} things`}:</h2>
      <ul>{errorList.map(([k, m]) => <li><a href={`#${k}`}>{m}</a></li>)}</ul>
    </div>
  )}

  <div class="eform__layout">
    <div class="eform__main">
      <!-- BASICS -->
      <fieldset class="card">
        <legend><h2>The basics</h2></legend>
        <div class="field">
          <label for="title">Event title <span class="req" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
          <input id="title" name="title" type="text" value={v.title} maxlength="140" required aria-invalid={inv('title')} aria-describedby={desc('title')} placeholder="e.g. Parents Night Out" />
          {errors.title && <span class="field-error" id="title-error">{errors.title}</span>}
        </div>
        <div class="field">
          <label for="summary">Short description</label>
          <textarea id="summary" name="summary" rows="2" maxlength="320" aria-describedby="summary-hint" data-counter>{v.summary}</textarea>
          <span class="hint" id="summary-hint">One or two friendly sentences shown on event cards. <span data-count></span></span>
        </div>
        <div class="field">
          <span class="label" id="desc-label">Full description</span>
          <div class="rte" data-rte>
            <div class="rte__toolbar" role="toolbar" aria-label="Formatting" hidden>
              <button type="button" data-cmd="bold" aria-label="Bold"><strong>B</strong></button>
              <button type="button" data-cmd="italic" aria-label="Italic"><em>I</em></button>
              <button type="button" data-cmd="formatBlock" data-arg="h3" aria-label="Heading">H</button>
              <button type="button" data-cmd="insertUnorderedList">Bullets</button>
              <button type="button" data-cmd="insertOrderedList">Numbers</button>
              <button type="button" data-cmd="createLink">Link</button>
              <button type="button" data-cmd="removeFormat">Clear formatting</button>
            </div>
            <div class="rte__editor" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="desc-label" hidden></div>
            <textarea name="descriptionHtml" class="rte__fallback" aria-labelledby="desc-label" rows="8">{v.descriptionHtml}</textarea>
          </div>
          <span class="hint">Shown on the event’s own page. Optional.</span>
        </div>
        <div class="row row--2">
          <div class="field">
            <label for="categoryId">Category</label>
            <select id="categoryId" name="categoryId">
              <option value="">— None —</option>
              {categories.map((c) => <option value={c.id} selected={v.categoryId === c.id}>{c.name}</option>)}
            </select>
          </div>
        </div>
      </fieldset>

      <!-- PHOTO -->
      <fieldset class="card">
        <legend><h2>Photo</h2></legend>
        <input type="hidden" name="imageId" value={image?.id ?? ''} data-image-id />
        <input type="hidden" name="focalX" value={fx} data-focal-x />
        <input type="hidden" name="focalY" value={fy} data-focal-y />
        <div class="uploader" data-uploader>
          <div class="uploader__preview" data-preview hidden={!image}>
            <button type="button" class="uploader__frame" data-focal aria-label="Photo preview. Click the most important part of the photo to keep it in view when cropped.">
              <img src={image?.url ?? ''} alt="" data-preview-img />
              <span class="uploader__dot" data-dot style={`left:${fx * 100}%;top:${fy * 100}%`}></span>
            </button>
            <p class="hint">Tip: click the most important part of the photo (like faces) so it stays in view when cropped.</p>
            <div class="btn-row">
              <label class="btn btn--ghost btn--sm" for="photo-file">Replace photo</label>
              <button type="button" class="btn btn--ghost btn--sm" data-remove>Remove photo</button>
            </div>
          </div>
          <label class="uploader__drop" for="photo-file" data-drop hidden={!!image}>
            <span class="uploader__icon" aria-hidden="true">＋</span>
            <span><strong>Drag a photo here</strong> or <u>choose a file</u></span>
            <span class="hint">JPG, PNG or WebP. Large phone photos are resized automatically.</span>
          </label>
          <input id="photo-file" type="file" accept="image/jpeg,image/png,image/webp" class="visually-hidden" data-file />
          <p class="uploader__status" data-status role="status" aria-live="polite"></p>
        </div>
        <div class="field" style="margin-top:1.25rem">
          <label for="imageAlt">Describe the photo {image && <span class="req" aria-hidden="true">*</span>}</label>
          <input id="imageAlt" name="imageAlt" type="text" value={v.imageAlt} maxlength="300" aria-invalid={inv('imageAlt')} aria-describedby={desc('imageAlt', 'alt-hint')} />
          <span class="hint" id="alt-hint">For people using screen readers, e.g. “Kids painting at a craft table in Congdon Hall.”</span>
          {errors.imageAlt && <span class="field-error" id="imageAlt-error">{errors.imageAlt}</span>}
        </div>
      </fieldset>

      <!-- WHEN -->
      <fieldset class="card">
        <legend><h2>Date &amp; time</h2></legend>
        <label class="check"><input type="checkbox" name="allDay" checked={v.allDay} data-allday /> All-day event</label>
        <div class="row row--2" style="margin-top:1.1rem">
          <div class="field">
            <label for="startDate">Start date <span class="req" aria-hidden="true">*</span><span class="visually-hidden">(required)</span></label>
            <input id="startDate" name="startDate" type="date" value={v.startDate} required aria-invalid={inv('startDate')} aria-describedby={desc('startDate')} />
            {errors.startDate && <span class="field-error" id="startDate-error">{errors.startDate}</span>}
          </div>
          <div class="field" data-time>
            <label for="startTime">Start time</label>
            <input id="startTime" name="startTime" type="time" value={v.startTime ?? ''} step="300" aria-invalid={inv('startTime')} aria-describedby={desc('startTime')} />
            {errors.startTime && <span class="field-error" id="startTime-error">{errors.startTime}</span>}
          </div>
          <div class="field">
            <label for="endDate">End date</label>
            <input id="endDate" name="endDate" type="date" value={v.endDate ?? ''} aria-invalid={inv('endDate')} aria-describedby={desc('endDate', 'endDate-hint')} />
            <span class="hint" id="endDate-hint">Leave blank if it ends the same day.</span>
            {errors.endDate && <span class="field-error" id="endDate-error">{errors.endDate}</span>}
          </div>
          <div class="field" data-time>
            <label for="endTime">End time</label>
            <input id="endTime" name="endTime" type="time" value={v.endTime ?? ''} step="300" aria-invalid={inv('endTime')} aria-describedby={desc('endTime')} />
            {errors.endTime && <span class="field-error" id="endTime-error">{errors.endTime}</span>}
          </div>
        </div>
        <div class="field">
          <label for="timezone">Time zone</label>
          <select id="timezone" name="timezone">
            {zones.map((z) => <option value={z} selected={v.timezone === z}>{z.replace('_', ' ')}</option>)}
          </select>
        </div>

        <div class="repeat">
          <div class="field">
            <label for="recurrenceFreq">Repeats</label>
            <select id="recurrenceFreq" name="recurrenceFreq" data-freq>
              <option value="none" selected={v.recurrenceFreq === 'none'}>Does not repeat</option>
              <option value="weekly" selected={v.recurrenceFreq === 'weekly'}>Weekly</option>
              <option value="monthly_weekday" selected={v.recurrenceFreq === 'monthly_weekday'}>Monthly, same weekday (e.g. second Sunday)</option>
              <option value="monthly_date" selected={v.recurrenceFreq === 'monthly_date'}>Monthly, same date (e.g. the 15th)</option>
            </select>
          </div>
          <div class="repeat__opts" data-repeat-opts hidden={v.recurrenceFreq === 'none'}>
            <div class="field" data-weekly hidden={v.recurrenceFreq !== 'weekly'}>
              <span class="label" id="days-label">On these days</span>
              <div class="days" role="group" aria-labelledby="days-label" id="recurrenceByDay">
                {WEEKDAYS.map((d) => (
                  <label class="day"><input type="checkbox" name="recurrenceByDay" value={d} checked={v.recurrenceByDay.includes(d)} /><span>{dayNames[d]}</span></label>
                ))}
              </div>
              {errors.recurrenceByDay && <span class="field-error">{errors.recurrenceByDay}</span>}
            </div>
            <div class="row row--2">
              <div class="field">
                <label for="recurrenceInterval">Every</label>
                <select id="recurrenceInterval" name="recurrenceInterval">
                  {[1, 2, 3, 4].map((n) => <option value={n} selected={v.recurrenceInterval === n}>{n === 1 ? 'Every time' : n === 2 ? 'Every other' : `Every ${n}th`}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="recurrenceUntil">Last date</label>
                <input id="recurrenceUntil" name="recurrenceUntil" type="date" value={v.recurrenceUntil ?? ''} aria-invalid={inv('recurrenceUntil')} aria-describedby="until-hint" />
                <span class="hint" id="until-hint">Leave blank to repeat until you change it.</span>
                {errors.recurrenceUntil && <span class="field-error">{errors.recurrenceUntil}</span>}
              </div>
            </div>
            <div class="field">
              <label for="recurrenceExceptions">Skip these dates</label>
              <input id="recurrenceExceptions" name="recurrenceExceptions" type="text" value={v.recurrenceExceptions.join(', ')} placeholder="2026-11-25, 2026-12-23" aria-invalid={inv('recurrenceExceptions')} aria-describedby="skip-hint" />
              <span class="hint" id="skip-hint">Holidays or breaks, as YYYY-MM-DD separated by commas.</span>
              {errors.recurrenceExceptions && <span class="field-error">{errors.recurrenceExceptions}</span>}
            </div>
          </div>
        </div>
      </fieldset>

      <!-- WHERE & WHO -->
      <fieldset class="card">
        <legend><h2>Location &amp; audience</h2></legend>
        <div class="row row--2">
          <div class="field">
            <label for="venue">Venue or room</label>
            <input id="venue" name="venue" type="text" value={v.venue} list="venues" maxlength="200" placeholder="e.g. Congdon Hall" />
            <datalist id="venues">
              {['Sanctuary', 'Congdon Hall', 'Fellowship Hall', 'The Lounge', 'Youth room', 'Library', 'Community Garden', 'Church kitchen', 'Online (Zoom)'].map((x) => <option value={x} />)}
            </datalist>
          </div>
          <div class="field">
            <label for="address">Street address</label>
            <input id="address" name="address" type="text" value={v.address} maxlength="300" placeholder="Leave blank for the church" />
          </div>
          <div class="field">
            <label for="audience">Who it’s for</label>
            <input id="audience" name="audience" type="text" value={v.audience} list="audiences" maxlength="120" placeholder="e.g. Families" />
            <datalist id="audiences">
              {['Everyone', 'Kids', 'Families', 'Students (grades 6–12)', 'Adults', 'Women', 'Men', 'Seniors'].map((x) => <option value={x} />)}
            </datalist>
          </div>
          <div class="field">
            <label for="cost">Cost</label>
            <input id="cost" name="cost" type="text" value={v.cost} maxlength="200" placeholder="e.g. $10 per child or $15 per family" />
          </div>
        </div>
      </fieldset>

      <!-- MORE -->
      <fieldset class="card">
        <legend><h2>More details</h2></legend>
        <div class="field">
          <label for="details">Bullet points</label>
          <textarea id="details" name="details" rows="4" aria-describedby="details-hint" placeholder={'Pizza, crafts and a movie\nSpace is limited'}>{v.details.join('\n')}</textarea>
          <span class="hint" id="details-hint">One per line. Shown as a short list.</span>
        </div>
        <label class="check" style="margin-top:1.1rem"><input type="checkbox" name="registrationRequired" checked={v.registrationRequired} data-reg /> Registration required</label>
        <div class="row row--2" style="margin-top:1.1rem">
          <div class="field">
            <label for="registrationUrl">Registration or info link</label>
            <input id="registrationUrl" name="registrationUrl" type="url" value={v.registrationUrl} maxlength="500" placeholder="https://… or tel:+18584903995" aria-invalid={inv('registrationUrl')} aria-describedby={desc('registrationUrl')} />
            {errors.registrationUrl && <span class="field-error" id="registrationUrl-error">{errors.registrationUrl}</span>}
          </div>
          <div class="field">
            <label for="registrationLabel">Button label</label>
            <input id="registrationLabel" name="registrationLabel" type="text" value={v.registrationLabel} maxlength="60" placeholder="e.g. Register now" />
          </div>
        </div>
        <div class="field">
          <label for="contact">Contact email or phone</label>
          <input id="contact" name="contact" type="text" value={v.contact} maxlength="200" placeholder="e.g. youth@northminstersandiego.com" />
        </div>
        <div class="field">
          <label for="notes">Internal notes</label>
          <textarea id="notes" name="notes" rows="3" aria-describedby="notes-hint">{v.notes}</textarea>
          <span class="hint" id="notes-hint">Only staff see these. Never shown on the website or calendar.</span>
        </div>
      </fieldset>
    </div>

    <!-- PUBLISHING -->
    <aside class="eform__side">
      <div class="card publish">
        <h2>Publishing</h2>
        <p class="publish__status">Status: <span class={`badge badge--${status}`}>{status[0].toUpperCase() + status.slice(1)}</span></p>
        <label class="check"><input type="checkbox" name="featured" checked={v.featured} /> <span>Feature on homepage<small>Featured events get priority in “What’s happening.”</small></span></label>
        <div class="publish__actions">
          {mode === 'new' || status === 'draft' || status === 'archived' ? (
            <>
              <button type="submit" name="intent" value="publish" class="btn btn--teal">Publish</button>
              <button type="submit" name="intent" value="draft" class="btn btn--ghost">Save draft</button>
            </>
          ) : (
            <>
              <button type="submit" name="intent" value="save" class="btn btn--teal">Update {status === 'cancelled' ? 'event' : 'live event'}</button>
              {status === 'published' && <button type="submit" name="intent" value="draft" class="btn btn--ghost" data-confirm="Unpublish this event? It will disappear from the website and be removed from Google Calendar.">Unpublish</button>}
            </>
          )}
          <button type="submit" formaction="/admin/events/preview" formtarget="_blank" class="btn btn--ghost" data-preview-btn>Preview</button>
          {mode === 'edit' && status === 'published' && (
            <button type="submit" name="intent" value="cancel_event" class="btn btn--ghost btn--danger-text" data-confirm="Mark this event as cancelled? It stays visible, clearly labeled “Cancelled”, on the website and Google Calendar.">Cancel event</button>
          )}
          {mode === 'edit' && status === 'cancelled' && (
            <button type="submit" name="intent" value="publish" class="btn btn--ghost">Un-cancel &amp; republish</button>
          )}
          <a href="/admin/events" class="btn btn--ghost" data-discard>Discard changes</a>
        </div>
        {isLive && <p class="hint">Changes go live within about a minute of updating.</p>}
      </div>
    </aside>
  </div>
</form>

<script>
  const form = document.getElementById('event-form') as HTMLFormElement;
  document.getElementById('error-summary')?.focus();

  // Character counter
  form.querySelectorAll<HTMLTextAreaElement>('[data-counter]').forEach((t) => {
    const out = t.parentElement!.querySelector('[data-count]')!;
    const upd = () => { out.textContent = `${t.value.length}/${t.maxLength}`; };
    t.addEventListener('input', upd); upd();
  });

  // All-day hides times
  const allDay = form.querySelector<HTMLInputElement>('[data-allday]')!;
  const syncAllDay = () => form.querySelectorAll<HTMLElement>('[data-time]').forEach((el) => { el.hidden = allDay.checked; });
  allDay.addEventListener('change', syncAllDay); syncAllDay();

  // Repeat options
  const freq = form.querySelector<HTMLSelectElement>('[data-freq]')!;
  const syncFreq = () => {
    form.querySelector<HTMLElement>('[data-repeat-opts]')!.hidden = freq.value === 'none';
    form.querySelector<HTMLElement>('[data-weekly]')!.hidden = freq.value !== 'weekly';
    if (freq.value === 'weekly' && !form.querySelector('input[name=recurrenceByDay]:checked')) {
      const d = (form.querySelector('#startDate') as HTMLInputElement).value;
      if (d) {
        const wd = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'][new Date(`${d}T12:00:00Z`).getUTCDay()];
        const box = form.querySelector<HTMLInputElement>(`input[name=recurrenceByDay][value=${wd}]`);
        if (box) box.checked = true;
      }
    }
  };
  freq.addEventListener('change', syncFreq); syncFreq();

  // End date defaults to start date
  const startDate = form.querySelector<HTMLInputElement>('#startDate')!;
  const endDate = form.querySelector<HTMLInputElement>('#endDate')!;
  startDate.addEventListener('change', () => { if (endDate.value && endDate.value < startDate.value) endDate.value = startDate.value; });

  // Rich text editor (progressive: falls back to a plain textarea)
  const rte = form.querySelector<HTMLElement>('[data-rte]')!;
  const editor = rte.querySelector<HTMLElement>('.rte__editor')!;
  const fallback = rte.querySelector<HTMLTextAreaElement>('.rte__fallback')!;
  editor.innerHTML = fallback.value;
  editor.hidden = false; rte.querySelector<HTMLElement>('.rte__toolbar')!.hidden = false;
  fallback.hidden = true;
  const syncRte = () => { fallback.value = editor.innerHTML.trim() === '<br>' ? '' : editor.innerHTML; };
  editor.addEventListener('input', syncRte);
  editor.addEventListener('paste', (e) => {
    e.preventDefault(); // paste as plain text to avoid hidden Word/Google Docs formatting
    document.execCommand('insertText', false, e.clipboardData?.getData('text/plain') ?? '');
  });
  rte.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) => b.addEventListener('click', () => {
    editor.focus();
    let arg = b.dataset.arg;
    if (b.dataset.cmd === 'createLink') {
      const url = prompt('Link address (https://…)');
      if (!url) return;
      if (!/^(https?:|mailto:|tel:)/i.test(url)) { alert('Links must start with https://, mailto: or tel:'); return; }
      arg = url;
    }
    document.execCommand(b.dataset.cmd!, false, arg);
    syncRte();
  }));

  // Photo upload
  const up = form.querySelector<HTMLElement>('[data-uploader]')!;
  const file = up.querySelector<HTMLInputElement>('[data-file]')!;
  const drop = up.querySelector<HTMLElement>('[data-drop]')!;
  const preview = up.querySelector<HTMLElement>('[data-preview]')!;
  const img = up.querySelector<HTMLImageElement>('[data-preview-img]')!;
  const status = up.querySelector<HTMLElement>('[data-status]')!;
  const idInput = form.querySelector<HTMLInputElement>('[data-image-id]')!;
  const fxIn = form.querySelector<HTMLInputElement>('[data-focal-x]')!;
  const fyIn = form.querySelector<HTMLInputElement>('[data-focal-y]')!;
  const dot = up.querySelector<HTMLElement>('[data-dot]')!;
  const MAX_EDGE = 2400, MAX_BYTES = 3.5 * 1024 * 1024;

  async function shrink(f: File): Promise<Blob> {
    const bmp = await createImageBitmap(f, { imageOrientation: 'from-image' });
    const scale = Math.min(1, MAX_EDGE / Math.max(bmp.width, bmp.height));
    if (scale === 1 && f.size <= MAX_BYTES) { bmp.close(); return f; }
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
    bmp.close();
    return new Promise((res, rej) => c.toBlob((b) => (b ? res(b) : rej(new Error('resize failed'))), 'image/jpeg', 0.86));
  }

  async function upload(f: File) {
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(f.type)) { status.textContent = 'Please choose a JPG, PNG or WebP image.'; return; }
    if (f.size > 40 * 1024 * 1024) { status.textContent = 'That file is very large. Please choose a smaller photo.'; return; }
    status.textContent = 'Uploading…';
    drop.setAttribute('aria-busy', 'true');
    try {
      const blob = await shrink(f);
      const body = new FormData();
      body.append('file', blob, f.name.replace(/\.\w+$/, '') + (blob.type === 'image/jpeg' ? '.jpg' : ''));
      const res = await fetch('/api/admin/images', { method: 'POST', body, headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? 'Upload failed.');
      idInput.value = data.id; img.src = data.url; fxIn.value = '0.5'; fyIn.value = '0.5';
      dot.style.left = '50%'; dot.style.top = '50%';
      preview.hidden = false; drop.hidden = true;
      status.textContent = 'Photo uploaded. Remember to describe it below, then save.';
      (form.querySelector('#imageAlt') as HTMLInputElement).focus();
    } catch (e) {
      status.textContent = (e as Error).message || 'Upload failed. Please try again.';
    } finally {
      drop.removeAttribute('aria-busy'); file.value = '';
    }
  }
  file.addEventListener('change', () => file.files?.[0] && upload(file.files[0]));
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('is-over')));
  drop.addEventListener('drop', (e) => { e.preventDefault(); const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f) upload(f); });
  up.querySelector('[data-remove]')!.addEventListener('click', () => {
    idInput.value = ''; img.src = ''; preview.hidden = true; drop.hidden = false;
    status.textContent = 'Photo removed. Save to apply.';
  });
  up.querySelector<HTMLButtonElement>('[data-focal]')!.addEventListener('click', (e) => {
    const r = img.getBoundingClientRect();
    const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
    if (!e.clientX && !e.clientY) return; // keyboard activation: keep center
    fxIn.value = x.toFixed(3); fyIn.value = y.toFixed(3);
    dot.style.left = `${x * 100}%`; dot.style.top = `${y * 100}%`;
    status.textContent = 'Focus point set.';
  });

  // Warn before leaving with unsaved changes
  let dirty = false;
